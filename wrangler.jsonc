{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boast",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/players/*", "/matches/*"]
  },
  // No id: `wrangler deploy` creates the database on first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "boast", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  // Set as secrets in the Cloudflare dashboard (they survive deploys):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, OWNER_EMAIL, and optionally RESEND_API_KEY.
  "vars": {
    "EMAIL_FROM": "Boast <onboarding@resend.dev>"
  },
  "observability": { "enabled": true },
  // Pull request previews (`wrangler preview`). Bindings and vars aren't inherited from
  // production, so previews get their own empty database (tables are created on first
  // request by worker/migrate.ts) and never touch live data. Secrets for previews are
  // set separately in the dashboard; without them previews work signed out.
  "previews": {
    "vars": {
      "EMAIL_FROM": "Boast <onboarding@resend.dev>"
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "boast-preview", "database_id": "eb7e0345-ab6b-4290-b5e1-4d72502788bc" }
    ]
  }
}
